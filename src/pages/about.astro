---
import Seo from '../components/Seo.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About | Dongming Zhao, LCSW</title>
  <meta name="description" content="Meet Dongming Zhao, LCSW &mdash; a licensed clinical social worker offering therapy for adults and couples, online throughout California." />
  <Seo title="About | Dongming Zhao, LCSW" description="Meet Dongming Zhao, LCSW—a licensed clinical social worker offering therapy for adults and couples, online throughout California." path="/about/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="page-about">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header site-header--inset">
    <div class="wrap site-header__inner">
      <a class="brand" href="/">Dongming Zhao</a>

      <nav class="nav" data-open="false" aria-label="Primary">
        <ul class="nav__links">
          <li><a href="/about/" aria-current="page">About</a></li>
          <li><a href="/individual-therapy/">Individual Therapy</a></li>
          <li><a href="/couples-therapy/">Couples Therapy</a></li>
          <li><a href="/zh/">&#20013;&#25991;&#24515;&#29702;</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li class="nav__action"><a class="btn btn--primary btn--pill" href="/contact/">Contact</a></li>
        </ul>
        <button class="nav__toggle" type="button" aria-label="Toggle menu" aria-expanded="false">
          <span class="nav__toggle-icon"></span>
        </button>
      </nav>
    </div>
  </header>

  <main id="main">

    <!-- 1 — Professional introduction: text and photograph, side by side -->
    <section class="ab-hero-section ab-spread ab-spread--hero">
      <div class="wrap ab-hero">
        <div class="ab-hero__text reveal">
          <span class="eyebrow">About me</span>
          <h1>Hi, I&rsquo;m Dongming.</h1>
          <hr class="rule" />
          <div class="prose ab-bio">
            <p class="lede">I&rsquo;m a Licensed Clinical Social Worker in California, providing therapy in English and Mandarin to adults and couples.</p>
            <p class="lede">I work with people navigating anxiety, depression, burnout, self-criticism, relationship difficulties, family-of-origin wounds, and the complexities of culture and identity.</p>
            <p class="lede">My approach is warm, collaborative, and depth-oriented. I draw from Internal Family Systems (IFS), Emotionally Focused Therapy (EFT), Acceptance and Commitment Therapy (ACT), and Cognitive Behavioral Therapy (CBT) to help you better understand the patterns beneath what you&rsquo;re experiencing &mdash; and find new ways of relating to yourself and the people who matter to you.</p>
          </div>
        </div>

        <figure class="ab-portrait reveal">
          <img src="/images/about-dongming.jpg" alt="Dongming Zhao, LCSW" width="1200" height="1200" decoding="async" />
        </figure>
      </div>
    </section>

    <!-- 2 — A little more about me: portrait + personal copy -->
    <section class="section section--band ab-spread ab-spread--personal">
      <div class="wrap ab-personal-grid">
        <figure class="ab-portrait2 reveal">
          <img src="/images/about-lanterns.jpg" alt="Dongming Zhao, LCSW" width="1080" height="1440" loading="lazy" decoding="async" />
        </figure>

        <div class="reveal ab-personal-copy">
          <span class="eyebrow">A little more about me</span>
          <h2 class="h-lg">A little more about me</h2>
          <div class="prose ab-personal">
            <p class="lede ink">I&rsquo;m a curious person by nature. I read a lot, especially about psychology, relationships, and culture, and I&rsquo;m usually thinking about something I&rsquo;ve recently learned.</p>
            <p class="lede">Outside of work, I enjoy walking, writing, and paying attention to things I find beautiful &mdash; art, clothes, interiors, or just small details in everyday life.</p>
            <p class="lede">I&rsquo;m interested in growth, but I don&rsquo;t think life needs to become a constant self-improvement project. I value having room to think, notice things, and enjoy ordinary life too.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 — Credentials: a compact information strip -->
    <section class="section section--tight ab-credentials-section">
      <div class="wrap">
        <div class="reveal ab-cred">
          <dl class="ab-cred__grid">
            <div class="ab-cred__item">
              <dt>Approaches</dt>
              <dd>
                <ul>
                  <li>Internal Family Systems (IFS)</li>
                  <li>Emotionally Focused Therapy (EFT)</li>
                  <li>Acceptance and Commitment Therapy (ACT)</li>
                  <li>Cognitive Behavioral Therapy (CBT)</li>
                </ul>
              </dd>
            </div>
            <div class="ab-cred__item">
              <dt>Languages</dt>
              <dd>English &amp; Mandarin</dd>
            </div>
            <div class="ab-cred__item">
              <dt>Location</dt>
              <dd>Online throughout California</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Closing CTA — the shared component; identical on every page -->
    <section class="section--ink cta">
      <div class="wrap">
        <h2 class="cta__title">If this feels like the right place to begin, I&rsquo;d love to hear from you.</h2>
        <div class="cta__actions">
          <a class="btn btn--primary" href="https://therapywithdongming.sessionshealth.com/request" target="_blank" rel="noopener noreferrer">Book a Free 15-Minute Consultation</a>
        </div>
        <p class="cta__email"><a href="mailto:therapywithdongming@gmail.com">therapywithdongming@gmail.com</a></p>
      </div>
    </section>

  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <p>&copy; <span id="year"></span> Dongming Zhao, LCSW</p>
      <ul class="site-footer__links">
        <li><a href="/about/">About</a></li>
        <li><a href="/individual-therapy/">Individual Therapy</a></li>
        <li><a href="/couples-therapy/">Couples Therapy</a></li>
        <li><a href="/zh/">&#20013;&#25991;&#24515;&#29702;</a></li>
        <li><a href="/blog/">Blog</a></li>
          <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <p class="site-footer__note">Website information is educational and is not emergency care.</p>
    </div>
  </footer>

  <script src="/main.js"></script>
  <script>document.getElementById("year").textContent = new Date().getFullYear();</script>
</body>
</html>
