---
import Base from '../../layouts/Base.astro';import site from '../../data/site.json';
const topics=[['焦虑、抑郁与情绪困扰','一起理解情绪背后的触发点、需要和思维模式，减少过度思考与内耗。'],['自我价值、身体意象与自我批评','理解苛刻的自我评价从何而来，逐渐建立更稳定、更温和的自我关系。'],['原生家庭、依恋创伤与亲密关系','理解反复出现的关系模式，练习边界、表达感受与需要，建立更有连接感的关系。'],['移民经历、文化与身份认同','为家庭、文化、移民经历和身份带来的复杂感受留出空间。'],['备孕、生育治疗与生育失落','按照你的节奏，为悲伤、愤怒、害怕、内疚和希望留出空间。']];
---
<Base title="中文心理咨询 | Dongming Zhao, LCSW" description="加州执业心理咨询师 Dongming Zhao（LCSW），为成年人和伴侣提供中文与英文心理咨询，线上服务加州全境。" path="/zh/" lang="zh-Hans">
<section class="section zh-hero"><div class="shell grid-2"><figure class="portrait zh-portrait reveal"><span class="portrait-accent" aria-hidden="true"></span><img src="images/portrait-dongming.jpg" alt="心理咨询师 Dongming Zhao" width="1080" height="1440"/></figure><div class="reveal"><p class="eyebrow">中文心理咨询</p><h1>你好，我是 Dongming。</h1><p class="lede">我是美国加州执业临床社会工作者（LCSW），为成年人和伴侣提供中文和英文心理咨询。</p><p>我的咨询风格温和、真诚，也重视对内在世界的深入探索。我会根据每个人不同的经历和需要，结合 IFS、EFT、ACT 和 CBT 开展工作。</p><p>心理咨询不是把你变成一个“更好”的人，而是帮助你更深地理解自己，与自己建立一种更温和、更真实的关系，并逐渐找到更适合自己的生活方式。</p><a class="button" href={site.bookingUrl} target="_blank" rel="noopener">预约免费 15 分钟咨询</a></div></div></section>
<section class="section band"><div class="shell"><p class="eyebrow">咨询方向</p><h2>我们可以一起面对的议题</h2><div class="cards">{topics.map(([t,d],i)=><article class="card reveal"><span class="number">0{i+1}</span><h3>{t}</h3><p>{d}</p></article>)}</div></div></section>
</Base>
