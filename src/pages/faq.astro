import Base from '../layouts/Base.astro';
const faqs=[['What happens in the first session?','We’ll talk about what brings you to therapy, what has been going on recently, and experiences or patterns that may be connected. You do not need to prepare or tell me everything at once.'],['How often do we meet?','Most clients meet weekly, especially at the beginning. As things improve and you feel ready, we may move to every other week.'],['How long do people typically stay in therapy?','There is no fixed timeline. Support around a specific stressor may be shorter-term, while longstanding patterns or complex trauma may take more time.'],['Do you work with trauma?','Yes. I take a trauma-informed approach. We will not rush into difficult experiences before you are ready, and we will pay attention to what feels manageable.'],['Do you see clients outside California?','For therapy, you must be physically located in California at the time of each session because I am licensed in California.'],['Do you offer in-person sessions?','Yes. I offer in-person sessions at my office in Anaheim, CA 92807, as well as telehealth throughout California.'],['Do you accept insurance?','I do not accept insurance directly. I can provide a superbill upon request for possible out-of-network reimbursement. Reimbursement varies by plan and is not guaranteed.'],['What are your fees?','Individual therapy is $200 per session. Couples therapy is $250 per session.'],['What is your cancellation policy?','I ask for at least 24 hours’ notice. Late cancellations are charged 50% of the session fee; missed appointments without notice are charged the full session fee.'],['What does couples intake look like?','Our first session is together. I then typically meet with each partner individually for one session before returning to joint sessions.'],['When might I not be the right therapist?','I may not be the right fit for crisis or emergency care, formal psychological evaluations, court-related documentation, or needs requiring a higher level of care. I will discuss referrals when possible.']];
---
