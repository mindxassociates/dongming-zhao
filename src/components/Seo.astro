---
import siteSettings from '../data/site.json';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: 'en' | 'zh-Hans';
  alternatePath?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  path,
  lang = 'en',
  alternatePath,
  type = 'website',
  image = '/images/hero.jpg',
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonical = new URL(path, Astro.site);
const socialImage = new URL(image, Astro.site);
const schema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      inLanguage: lang,
      datePublished: publishedTime?.toISOString(),
      dateModified: (modifiedTime || publishedTime)?.toISOString(),
      mainEntityOfPage: canonical.href,
      author: { '@type': 'Person', name: siteSettings.name },
      publisher: { '@type': 'Person', name: siteSettings.name },
      image: socialImage.href,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: siteSettings.name,
      url: new URL('/', Astro.site).href,
      email: siteSettings.email,
      areaServed: { '@type': 'State', name: 'California' },
      availableLanguage: ['English', 'Mandarin Chinese'],
    };
---
<link rel="canonical" href={canonical} />
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={lang === 'zh-Hans' ? 'zh_CN' : 'en_US'} />
<meta property="og:image" content={socialImage} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="alternate" hreflang={lang === 'zh-Hans' ? 'zh-Hans' : 'en'} href={canonical} />
{alternatePath && <link rel="alternate" hreflang={lang === 'zh-Hans' ? 'en' : 'zh-Hans'} href={new URL(alternatePath, Astro.site)} />}
<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
